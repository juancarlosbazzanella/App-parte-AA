[Unit]
Description=Check ClimaGest backup freshness
After=network-online.target
OnFailure=climagest-backup-alert.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/climagest-backup/backup_operations.py --config /etc/climagest-backup/config.json --event health
TimeoutStartSec=2min
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/climagest /run
PrivateTmp=yes
